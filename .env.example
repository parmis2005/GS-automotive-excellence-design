# PostgreSQL (REQUIRED)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server
PORT=3001
SYNC_INTERVAL_MINUTES=30

# CarGate Carzilla V6 API (optional, empfohlen für Bestandsdaten)
# Basis-URL aus der Schnittstellenbeschreibung (Carzilla V6 PDF) übernehmen.
# CARGATE_API_KEY=<Ihr API-Key von CarGate>
# CARGATE_API_BASE_URL=<laut Carzilla V6 PDF>
# CARGATE_VEHICLES_PATH=vehicles
# CARGATE_BRANCH_ID=1790
# Optional: Nur Fahrzeuge mit diesen Status-IDs (z. B. „online“) – kommasepariert, z. B. CARGATE_ONLINE_STATUS_IDS=2,3
# CARGATE_ONLINE_STATUS_IDS=
# Optional: Basis-URL für Exposé-PDF (wenn keine Vorlage gesetzt). Standard: https://fahrzeuge.gs-automobile-rheinland.de
# CARGATE_EXPOSE_BASE_URL=
# Optional: Exposé mit vid= (Fahrzeug-ID) statt oid= (UUID). Standard: vid wird verwendet, wenn die API keinen Oid/UUID liefert (Carzilla V6-Doku beschreibt keinen Exposé-Download).
# CARGATE_EXPOSE_USE_VID=true
# Optional: Exposé-URL-Vorlage. Platzhalter: {id}, {vehicleId}, {oid}, {vid}, {ourl}. Beispiel: https://example.de/Expose.pdf?oid={oid}&ourl={ourl}
# CARGATE_EXPOSE_URL_TEMPLATE=

# Resend – E-Mail-Versand für Ankauf-Anfragen
# 1. Konto erstellen: https://resend.com (kostenlos)
# 2. API-Key: https://resend.com/api-keys → Create API Key
# 3. In .env eintragen:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Absender – für Tests ohne eigene Domain:
RESEND_FROM=onboarding@resend.dev
# RESEND_FROM_GENERAL=noreply@gsauto.de
# Eigene Domain: Domain unter https://resend.com/domains verifizieren, dann z.B.:
# RESEND_FROM=Ankauf <anfragen@send.gsauto.de>
# Empfänger – hier landen die Ankauf-Anfragen:
RESEND_TO=info@gsauto.de

# Supabase Storage (Ankauf-Uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_ANKAUF=ankauf-uploads

# Frontend (Vite) – API-Basis für Browser-Requests (Produktion)
# Ohne Variable: /api über Vercel. Für große Ankauf-Uploads (>~4 MB) entweder alles direkt:
# VITE_API_URL=https://api.gsauto.de
# …oder nur Ankauf-POST direkt (Fahrzeuglisten bleiben über Vercel /api):
# VITE_PURCHASE_API_BASE=https://api.gsauto.de
# Hinweis: Viele Fotos gehen bei aktuellem Stand per Direkt-Upload zu Supabase (kleine JSON-Calls
# prepare-uploads/complete über Vercel). Multipart-Fallback nur wenn Supabase am Server fehlt (503).
# (HTTPS-Subdomain zum Droplet; nginx client_max_body_size z. B. 35m; Proxy auf Port 3001)
# VITE_API_URL=
# VITE_PURCHASE_API_BASE=

# Santander Kredit Widget
# AKZ und Händlernummer bekommst du vom Santander-Widget-Anbieter.
VITE_SANTANDER_AKZ=
VITE_SANTANDER_DEALERNR=
# Optional (falls ihr abweichende Werte verwenden wollt)
VITE_SANTANDER_DISPLAY_PLACEMENT=1948
VITE_SANTANDER_ANNUAL_PERCENTAGE_RATE=5.99
