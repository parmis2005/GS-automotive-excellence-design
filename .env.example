# PostgreSQL (REQUIRED)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server
PORT=3001
SYNC_INTERVAL_MINUTES=30

# CarGate Carzilla V6 API (optional, empfohlen für Bestandsdaten)
# Basis-URL aus der Schnittstellenbeschreibung (Carzilla V6 PDF) übernehmen.
# CARGATE_API_KEY=<Ihr API-Key von CarGate>
# CARGATE_API_BASE_URL=<laut Carzilla V6 PDF>
# CARGATE_VEHICLES_PATH=vehicles
# CARGATE_BRANCH_ID=1790
# Optional: Nur Fahrzeuge mit diesen Status-IDs (z. B. „online“) – kommasepariert, z. B. CARGATE_ONLINE_STATUS_IDS=2,3
# CARGATE_ONLINE_STATUS_IDS=
# Optional: Basis-URL für Exposé-PDF (wenn keine Vorlage gesetzt). Standard: https://fahrzeuge.gs-automobile-rheinland.de
# CARGATE_EXPOSE_BASE_URL=
# Optional: Exposé mit vid= (Fahrzeug-ID) statt oid= (UUID). Setzen, wenn die Händlerseite vid erwartet (z. B. bei 404).
# CARGATE_EXPOSE_USE_VID=true
# Optional: Exposé-URL-Vorlage. Platzhalter: {id}, {vehicleId}, {oid}, {vid}, {ourl}. Beispiel: https://example.de/Expose.pdf?oid={oid}&ourl={ourl}
# CARGATE_EXPOSE_URL_TEMPLATE=
