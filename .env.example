# PostgreSQL (REQUIRED)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server
PORT=3001
SYNC_INTERVAL_MINUTES=30

# CarGate Carzilla V6 API (optional, empfohlen für Bestandsdaten)
# Basis-URL aus der Schnittstellenbeschreibung (Carzilla V6 PDF) übernehmen.
# CARGATE_API_KEY=<Ihr API-Key von CarGate>
# CARGATE_API_BASE_URL=<laut Carzilla V6 PDF>
# CARGATE_VEHICLES_PATH=vehicles
# CARGATE_BRANCH_ID=1790
